{
  "name": "open-bim",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core && tsc -p packages/geometry && tsc -p packages/library && tsc -p apps/desktop",
    "dev": "npm run dev -w @open-bim/desktop",
    "build": "npm run build -w @open-bim/desktop",
    "tauri": "npm run tauri -w @open-bim/desktop --"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
